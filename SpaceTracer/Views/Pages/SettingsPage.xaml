<Page x:Class="WinTracer.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="clr-namespace:WinTracer.Localization"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="{l:Loc Nav.Settings}">
    <StackPanel Margin="42,24,42,24">
        <ui:TextBlock Text="{l:Loc Nav.Settings}" FontTypography="Title" Margin="0,0,0,16" />

        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="DesignIdeas20" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="{l:Loc SettingsPage.Theme}" FontTypography="BodyStrong" />
                    <ui:TextBlock Text="{l:Loc SettingsPage.ThemeHint}" Appearance="Secondary" />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox MinWidth="180"
                      ItemsSource="{Binding Themes}"
                      DisplayMemberPath="Value"
                      SelectedValuePath="Key"
                      SelectedValue="{Binding SelectedTheme}" />
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="LocalLanguage20" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="{l:Loc SettingsPage.Language}" FontTypography="BodyStrong" />
                    <ui:TextBlock Text="{l:Loc SettingsPage.LanguageHint}" Appearance="Secondary" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:Button Content="{l:Loc SettingsPage.RestartNow}" Margin="0,0,8,0" Appearance="Primary"
                           Command="{Binding RestartCommand}"
                           Visibility="{Binding LanguageChanged, Converter={StaticResource BoolToVisibility}}" />
                <ComboBox MinWidth="180"
                          ItemsSource="{Binding Languages}"
                          DisplayMemberPath="Value"
                          SelectedValuePath="Key"
                          SelectedValue="{Binding SelectedLanguage}" />
            </StackPanel>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="ShieldKeyhole20" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="{l:Loc SettingsPage.Admin}" FontTypography="BodyStrong" />
                    <ui:TextBlock Appearance="Secondary"
                                  Text="{l:Loc SettingsPage.AdminHint}" />
                </StackPanel>
            </ui:CardControl.Header>
            <Grid>
                <ui:Button Content="{l:Loc SettingsPage.RestartAdmin}"
                           Appearance="Primary"
                           Command="{Binding RestartElevatedCommand}"
                           Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVisibility}}" />
                <ui:TextBlock Text="{l:Loc SettingsPage.AlreadyAdmin}"
                              VerticalAlignment="Center"
                              Visibility="{Binding IsElevated, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </ui:CardControl>

        <ui:CardControl>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Info20" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="{l:Loc SettingsPage.About}" FontTypography="BodyStrong" />
                    <ui:TextBlock Appearance="Secondary" Text="{Binding Version, StringFormat='WinTracer {0}'}" />
                </StackPanel>
            </ui:CardControl.Header>
        </ui:CardControl>
    </StackPanel>
</Page>

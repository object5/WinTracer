<Page x:Class="WinTracer.Views.Pages.TweaksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="clr-namespace:WinTracer.Localization"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:WinTracer.ViewModels"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:TweaksViewModel}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="{l:Loc Nav.Tweaks}"
      ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="CautionText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="24,8,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
            <ui:TextBlock DockPanel.Dock="Left" Text="{l:Loc Nav.Tweaks}" FontTypography="Title" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="{l:Loc Common.AsAdmin}" Margin="0,0,8,0" Command="{Binding RestartElevatedCommand}"
                           Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVisibility}}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ShieldKeyhole20" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button Content="{l:Loc Common.Refresh}" Command="{Binding RefreshCommand}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowClockwise20" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </DockPanel>

        <ui:InfoBar Grid.Row="1" Margin="0,0,0,12"
                    Message="{Binding NoticeMessage}"
                    Severity="{Binding NoticeSeverity}"
                    IsOpen="{Binding HasNotice, Mode=TwoWay}" />

        <StackPanel Grid.Row="2">
            <ui:Card Margin="0,0,0,12" Padding="16,10"
                     Visibility="{Binding ExplorerRestartSuggested, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Content="{l:Loc TweaksPage.RestartExplorer}" Command="{Binding RestartExplorerCommand}" />
                    <TextBlock VerticalAlignment="Center" Text="{l:Loc TweaksPage.ExplorerNeeded}" TextWrapping="Wrap" />
                </DockPanel>
            </ui:Card>
            <ui:Card Margin="0,0,0,12" Padding="16,10"
                     Visibility="{Binding RebootSuggested, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{l:Loc TweaksPage.RebootNeeded}" TextWrapping="Wrap" />
            </ui:Card>
        </StackPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="2,0,0,4"
                           Text="{l:Loc TweaksPage.Intro}" />

                <ItemsControl ItemsSource="{Binding TweaksView}">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <ui:TextBlock Text="{Binding Name}" FontTypography="BodyStrong" FontSize="16" Margin="2,16,0,8" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TweakItemViewModel}">
                            <Border Margin="0,0,0,4" Padding="16,12" CornerRadius="6"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Description}" FontSize="12" Style="{StaticResource SecondaryText}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding Warning}" Style="{StaticResource CautionText}" />
                                        <TextBlock Text="{Binding StateText}" Style="{StaticResource CautionText}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding EffectText}" FontSize="12" Margin="0,0,12,0"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EffectText}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{l:Loc Common.NeedsAdmin}" FontSize="12"
                                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                       Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                                                         Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:ToggleSwitch IsChecked="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding CanToggle}"
                                                         OnContent="{l:Loc Common.On}" OffContent="{l:Loc Common.Off}" MinWidth="90"
                                                         AutomationProperties.Name="{Binding Title}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ui:TextBlock Text="{l:Loc TweaksPage.Apps}" FontTypography="BodyStrong" FontSize="16" Margin="2,20,0,4" />
                <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="2,0,0,8" FontSize="12"
                           Text="{l:Loc TweaksPage.AppsHint}" />
                <ui:ProgressRing IsIndeterminate="True" HorizontalAlignment="Left" Margin="2,4,0,8"
                                 Visibility="{Binding AppsLoading, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{l:Loc TweaksPage.NoApps}" Style="{StaticResource SecondaryText}" Margin="2,0,0,8"
                           Visibility="{Binding NoAppsLeft, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Apps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BuiltInAppViewModel}">
                            <Border Margin="0,0,0,4" Padding="16,10" CornerRadius="6"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                                                         Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:Button Content="{l:Loc Common.Delete}" Command="{Binding RemoveCommand}">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Delete20" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding PackageName}" FontSize="12" Style="{StaticResource SecondaryText}" />
                                        <TextBlock Text="{Binding Warning}" Style="{StaticResource CautionText}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

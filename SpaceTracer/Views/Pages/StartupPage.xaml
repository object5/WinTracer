<Page x:Class="WinTracer.Views.Pages.StartupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="clr-namespace:WinTracer.Localization"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:WinTracer.ViewModels"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:StartupViewModel}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="{l:Loc Nav.Startup}"
      ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="TertiaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid Margin="24,8,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
            <ui:TextBlock DockPanel.Dock="Left" Text="{l:Loc Nav.Startup}" FontTypography="Title" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="{l:Loc Common.AsAdmin}" Margin="0,0,8,0"
                           ToolTip="{l:Loc StartupPage.AdminTip}"
                           Command="{Binding RestartElevatedCommand}"
                           Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVisibility}}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ShieldKeyhole20" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button Content="{l:Loc Common.Backups}" Margin="0,0,8,0" Command="{Binding OpenBackupsCommand}"
                           ToolTip="{l:Loc StartupPage.BackupsTip}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="History20" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button Content="{l:Loc Common.Refresh}" Command="{Binding RefreshCommand}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowClockwise20" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </DockPanel>

        <ui:InfoBar Grid.Row="1" Margin="0,0,0,12"
                    Title="{l:Loc StartupPage.AdminTitle}"
                    Message="{l:Loc StartupPage.AdminMessage}"
                    Severity="Informational"
                    IsOpen="{Binding ShowElevationHint, Mode=TwoWay}" />

        <ui:InfoBar Grid.Row="2" Margin="0,0,0,12"
                    Message="{Binding NoticeMessage}"
                    Severity="{Binding NoticeSeverity}"
                    IsOpen="{Binding HasNotice, Mode=TwoWay}" />

        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0" Margin="0,0,8,0"
                        PlaceholderText="{l:Loc StartupPage.Search}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Search20" />
                </ui:TextBox.Icon>
            </ui:TextBox>
            <ComboBox Grid.Column="1" MinWidth="180"
                      ItemsSource="{Binding Filters}"
                      DisplayMemberPath="Value"
                      SelectedValuePath="Key"
                      SelectedValue="{Binding Filter}" />
        </Grid>

        <StackPanel Grid.Row="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <ui:ProgressRing IsIndeterminate="True" />
            <TextBlock Margin="0,12,0,0" Text="{l:Loc StartupPage.Loading}" Style="{StaticResource SecondaryText}" />
        </StackPanel>

        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding View}" Margin="0,0,12,0">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Margin="2,12,0,8" FontSize="16" FontWeight="SemiBold">
                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                    <Run Text="{Binding ItemCount, Mode=OneWay, StringFormat='({0})'}"
                                         Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </TextBlock>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:StartupItemViewModel}">
                        <Border Margin="0,0,0,4" Padding="16,10" CornerRadius="6"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Width="32" Height="32" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <Image Source="{Binding Icon}" Width="32" Height="32"
                                           Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                                    <ui:SymbolIcon Symbol="{Binding FallbackIcon}" FontSize="24"
                                                   Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVisibility}}" />
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Style="{StaticResource SecondaryText}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding Command}" FontSize="11" Style="{StaticResource TertiaryText}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding Location}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{l:Loc StartupPage.FileMissing}" FontSize="12" Margin="0,0,12,0"
                                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                   Visibility="{Binding FileMissing, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{l:Loc Common.NeedsAdmin}" FontSize="12"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                   Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <ui:Button Margin="0,0,4,0" ToolTip="{l:Loc StartupPage.ShowFile}"
                                               Appearance="Transparent"
                                               Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding}"
                                               Visibility="{Binding FileMissing, Converter={StaticResource InverseBoolToVisibility}}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="FolderOpen20" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button Margin="0,0,12,0" ToolTip="{l:Loc StartupPage.DeleteTip}"
                                               Appearance="Transparent"
                                               Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding}"
                                               Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Delete20" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                    <ui:ToggleSwitch IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                     IsEnabled="{Binding CanToggle}"
                                                     OnContent="{l:Loc Common.On}" OffContent="{l:Loc Common.Off}" MinWidth="90"
                                                     AutomationProperties.Name="{Binding Name}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="5" Margin="2,8,0,0" FontSize="12" Style="{StaticResource SecondaryText}">
            <Run Text="{Binding Summary, Mode=OneWay}" />
            <Run Text="{l:Loc StartupPage.Footer}" />
        </TextBlock>
    </Grid>
</Page>

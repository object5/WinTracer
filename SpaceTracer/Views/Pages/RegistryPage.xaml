<Page x:Class="WinTracer.Views.Pages.RegistryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="clr-namespace:WinTracer.Localization"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:WinTracer.ViewModels"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:RegistryViewModel}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="{l:Loc Nav.Registry}"
      ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="TertiaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid Margin="24,8,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
            <ui:TextBlock DockPanel.Dock="Left" Text="{l:Loc Nav.Registry}" FontTypography="Title" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="{l:Loc Common.AsAdmin}" Margin="0,0,8,0" Command="{Binding RestartElevatedCommand}"
                           Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVisibility}}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ShieldKeyhole20" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button Content="{l:Loc Common.Backups}" Margin="0,0,8,0" Command="{Binding OpenBackupsCommand}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="History20" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button Content="{l:Loc RegistryPage.Rescan}" Command="{Binding ScanCommand}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowClockwise20" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </DockPanel>

        <ui:InfoBar Grid.Row="1" Margin="0,0,0,12"
                    Title="{l:Loc RegistryPage.AdminTitle}"
                    Message="{l:Loc RegistryPage.AdminMessage}"
                    Severity="Informational"
                    IsOpen="{Binding ShowElevationHint, Mode=TwoWay}" />

        <ui:InfoBar Grid.Row="2" Margin="0,0,0,12"
                    Message="{Binding NoticeMessage}"
                    Severity="{Binding NoticeSeverity}"
                    IsOpen="{Binding HasNotice, Mode=TwoWay}" />

        <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <ui:ProgressRing IsIndeterminate="True" />
            <TextBlock Margin="0,12,0,0" Text="{Binding BusyText}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Margin="2,0,0,12" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                           Text="{l:Loc RegistryPage.Intro}" />
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RegistryCategoryViewModel}">
                            <ui:CardExpander Margin="0,0,0,6">
                                <ui:CardExpander.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" MinWidth="0" Margin="0,0,8,0" VerticalAlignment="Center"
                                                  IsThreeState="False" IsChecked="{Binding IsAllSelected}"
                                                  AutomationProperties.Name="{Binding Title}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Description}" FontSize="12" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Margin="16,0,8,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                                   Text="{Binding Count}" />
                                    </Grid>
                                </ui:CardExpander.Header>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:RegistryIssueViewModel}">
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" MinWidth="0" Margin="0,0,8,0" VerticalAlignment="Top"
                                                          IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding MissingText}" FontSize="12" Style="{StaticResource SecondaryText}"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding MissingText}" />
                                                    <TextBlock Text="{Binding Location}" FontSize="11" Style="{StaticResource TertiaryText}"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Location}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ui:CardExpander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="4" Margin="0,12,0,0" Padding="16,12" CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <CheckBox Content="{l:Loc RegistryPage.RestorePoint}" Margin="0,0,16,0" VerticalAlignment="Center"
                              IsChecked="{Binding CreateRestorePoint}" IsEnabled="{Binding IsElevated}"
                              ToolTip="{l:Loc RegistryPage.RestorePointTip}" />
                    <ui:Button Content="{l:Loc RegistryPage.FixSelected}" Appearance="Primary" Command="{Binding FixCommand}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Wrench20" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Summary}" />
            </DockPanel>
        </Border>
    </Grid>
</Page>

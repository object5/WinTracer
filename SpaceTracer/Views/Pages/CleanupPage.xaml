<Page x:Class="WinTracer.Views.Pages.CleanupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="clr-namespace:WinTracer.Localization"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:WinTracer.ViewModels"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:CleanupViewModel}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="{l:Loc Nav.Cleanup}"
      ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <CollectionViewSource x:Key="GroupedItems" Source="{Binding Items}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="GroupTitle" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid Margin="24,8,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
            <ui:TextBlock DockPanel.Dock="Left" Text="{l:Loc Nav.Cleanup}" FontTypography="Title" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="{l:Loc CleanupPage.Recommended}" Margin="0,0,8,0" Command="{Binding SelectRecommendedCommand}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Checkmark20" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button Content="{l:Loc CleanupPage.SelectNone}" Margin="0,0,8,0" Command="{Binding SelectNoneCommand}" />
                <ui:Button Content="{l:Loc CleanupPage.Reanalyze}" Command="{Binding AnalyzeCommand}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowClockwise20" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </DockPanel>

        <ui:InfoBar Grid.Row="1" Margin="0,0,0,12"
                    Title="{l:Loc CleanupPage.AdminTitle}"
                    Message="{l:Loc CleanupPage.AdminMessage}"
                    Severity="Informational"
                    IsOpen="{Binding ShowElevationHint, Mode=TwoWay}" />

        <ui:InfoBar Grid.Row="2" Margin="0,0,0,12"
                    Title="{l:Loc CleanupPage.Done}"
                    Message="{Binding ResultMessage}"
                    Severity="{Binding ResultSeverity}"
                    IsOpen="{Binding HasResult, Mode=TwoWay}" />

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedItems}}" Margin="0,0,12,0">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <ui:TextBlock Text="{Binding Name}" FontTypography="BodyStrong" FontSize="16" Margin="2,16,0,8" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CleanupItemViewModel}">
                        <Border Margin="0,0,0,4" Padding="16,12" CornerRadius="6"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" VerticalAlignment="Center" MinWidth="0" Margin="0,0,4,0"
                                          IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}"
                                          AutomationProperties.Name="{Binding Title}" />
                                <ui:SymbolIcon Grid.Column="1" Symbol="{Binding Icon}" FontSize="20" Margin="4,0,14,0"
                                               VerticalAlignment="Center" />

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" FontSize="12"
                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding Warning}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Warning}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock FontSize="12" Margin="0,4,0,0" Text="{l:Loc Common.NeedsAdmin}"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                               Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding RunningText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RunningText}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Foreground="{DynamicResource SystemFillColorSuccessBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusText}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding SizeText}" MinWidth="80" TextAlignment="Right" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="4" Margin="0,12,0,0" Padding="16,12" CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button Content="{l:Loc CleanupPage.Stop}" Margin="0,0,8,0" Command="{Binding CancelCommand}"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Content="{l:Loc CleanupPage.CleanSelected}" Appearance="Primary" Command="{Binding CleanCommand}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Broom20" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedSummary}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource SecondaryText}" FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Page>

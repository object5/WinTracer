<Page x:Class="WinTracer.Views.Pages.DiskAnalyzerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="clr-namespace:WinTracer.Localization"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:WinTracer.ViewModels"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:DiskAnalyzerViewModel}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="{l:Loc Nav.Disk}"
      ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid Margin="24,8,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
            <ui:TextBlock DockPanel.Dock="Left" Text="{l:Loc Nav.Disk}" FontTypography="Title" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="{l:Loc Common.AsAdmin}" Margin="0,0,8,0"
                           ToolTip="{l:Loc DiskPage.AdminTip}"
                           Command="{Binding RestartElevatedCommand}"
                           Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVisibility}}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ShieldKeyhole20" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button Content="{l:Loc DiskPage.RefreshDrives}" Margin="0,0,8,0" Command="{Binding RefreshDrivesCommand}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowSync20" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button Content="{l:Loc DiskPage.ScanFolder}" Appearance="Primary" Command="{Binding ScanFolderCommand}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Search20" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </DockPanel>

        <ui:InfoBar Grid.Row="1" Margin="0,0,0,12"
                    Title="{l:Loc DiskPage.NotAdminTitle}"
                    Message="{l:Loc DiskPage.NotAdminMessage}"
                    Severity="Informational"
                    IsOpen="{Binding ShowElevationHint, Mode=TwoWay}" />

        <ItemsControl Grid.Row="2" ItemsSource="{Binding Drives}" Margin="0,0,0,8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DriveItemViewModel}">
                    <ui:CardAction Width="290" Margin="0,0,8,8" Padding="14,12"
                                   IsChevronVisible="False"
                                   AutomationProperties.Name="{Binding Title}"
                                   ToolTip="{l:Loc DiskPage.ScanDrive}"
                                   Command="{Binding DataContext.ScanDriveCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                   CommandParameter="{Binding}">
                        <ui:CardAction.Icon>
                            <ui:SymbolIcon Symbol="HardDrive20" FontSize="26" />
                        </ui:CardAction.Icon>
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Details}" Style="{StaticResource SecondaryText}" FontSize="12" />
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <ProgressBar Height="6" Margin="0,8,0,6" Maximum="100" Value="{Binding UsedPercent, Mode=OneWay}">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLowSpace}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                            <TextBlock Text="{Binding UsageText}" Style="{StaticResource SecondaryText}" FontSize="12" />
                        </StackPanel>
                    </ui:CardAction>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ui:Card Grid.Row="3" Margin="0,0,0,12" Padding="16,12"
                 Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:ProgressRing Grid.Column="0" IsIndeterminate="True" Width="28" Height="28" Margin="0,0,16,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold">
                        <Run Text="{l:Loc DiskPage.Scanning}" />
                        <Run Text="{Binding ScanTarget, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding ProgressText}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding CurrentPath}" Style="{StaticResource SecondaryText}" FontSize="12"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
                <ui:Button Grid.Column="2" Content="{l:Loc Common.Cancel}" VerticalAlignment="Center" Command="{Binding CancelCommand}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Dismiss20" />
                    </ui:Button.Icon>
                </ui:Button>
            </Grid>
        </ui:Card>

        <StackPanel Grid.Row="4">
            <ui:InfoBar Margin="0,0,0,12"
                        Title="{l:Loc DiskPage.ScanIncomplete}"
                        Message="{Binding ErrorMessage}"
                        Severity="Warning"
                        IsOpen="{Binding HasError, Mode=TwoWay}" />
            <ui:InfoBar Margin="0,0,0,12"
                        Message="{Binding NoticeMessage}"
                        Severity="{Binding NoticeSeverity}"
                        IsOpen="{Binding HasNotice, Mode=TwoWay}" />
        </StackPanel>

        <StackPanel Grid.Row="5" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding HasResult, Converter={StaticResource InverseBoolToVisibility}}">
            <ui:SymbolIcon Symbol="DataTreemap20" FontSize="48" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" Style="{StaticResource SecondaryText}"
                       Text="{l:Loc DiskPage.Empty}" />
        </StackPanel>

        <Grid Grid.Row="5" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="220" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="8" Padding="4"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <TreeView x:Name="FolderTree"
                          ItemsSource="{Binding RootNodes}"
                          SelectedItemChanged="FolderTree_SelectedItemChanged"
                          PreviewMouseRightButtonDown="FolderTree_PreviewMouseRightButtonDown"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <TreeView.InputBindings>
                        <KeyBinding Key="Delete" Command="{Binding DeleteToRecycleBinCommand}" CommandParameter="{Binding SelectedFolder}" />
                        <KeyBinding Key="Delete" Modifiers="Shift" Command="{Binding DeletePermanentlyCommand}" CommandParameter="{Binding SelectedFolder}" />
                    </TreeView.InputBindings>
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{l:Loc Common.ShowInExplorer}" Command="{Binding ShowInExplorerCommand}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="FolderOpen20" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{l:Loc Common.CopyPath}" Command="{Binding CopyPathCommand}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Copy20" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{l:Loc DiskPage.Move}" Command="{Binding MoveCommand}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="FolderArrowRight20" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{l:Loc DiskPage.Recycle}" InputGestureText="Del" Command="{Binding DeleteToRecycleBinCommand}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Delete20" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{l:Loc DiskPage.DeleteForever}" InputGestureText="Shift+Del" Command="{Binding DeletePermanentlyCommand}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="DeleteDismiss20" /></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <EventSetter Event="Selected" Handler="TreeViewItem_Selected" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type vm:FolderNodeViewModel}" ItemsSource="{Binding Children}">
                            <Grid ToolTip="{Binding Node.FullPath}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Margin="0,0,6,0">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Symbol" Value="Folder20" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AccessDenied}" Value="True">
                                                    <Setter Property="Symbol" Value="FolderProhibited20" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Margin="12,0,4,0" VerticalAlignment="Center" FontSize="12"
                                           Style="{StaticResource SecondaryText}"
                                           Text="{Binding Size, Converter={StaticResource Bytes}}" />
                            </Grid>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <ui:Button DockPanel.Dock="Left" Margin="0,0,8,0" ToolTip="{l:Loc DiskPage.Up}"
                               Command="{Binding GoUpCommand}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowUp20" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" ToolTip="{l:Loc DiskPage.OpenInExplorer}"
                               Command="{Binding OpenCurrentFolderCommand}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="FolderOpen20" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedFolder.Node.FullPath}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="12" Style="{StaticResource SecondaryText}">
                            <Run Text="{Binding SelectedFolder.Size, Mode=OneWay, Converter={StaticResource Bytes}}" />
                            <Run Text="·" />
                            <Run Text="{Binding SelectedFolder.Node.FileCount, Mode=OneWay, StringFormat={l:Loc DiskPage.FilesFormat}}" />
                            <Run Text="·" />
                            <Run Text="{Binding SelectedFolder.Node.DirCount, Mode=OneWay, StringFormat={l:Loc DiskPage.FoldersFormat}}" />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>

                <ui:DataGrid x:Name="ItemsGrid" Grid.Row="1"
                          MouseDoubleClick="ItemsGrid_MouseDoubleClick"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding OpenCommand}" CommandParameter="{Binding SelectedItem}" />
                        <KeyBinding Key="Back" Command="{Binding GoUpCommand}" />
                        <KeyBinding Key="Delete" Command="{Binding DeleteToRecycleBinCommand}"
                                    CommandParameter="{Binding SelectedItems, ElementName=ItemsGrid}" />
                        <KeyBinding Key="Delete" Modifiers="Shift" Command="{Binding DeletePermanentlyCommand}"
                                    CommandParameter="{Binding SelectedItems, ElementName=ItemsGrid}" />
                    </DataGrid.InputBindings>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{l:Loc Common.Open}" InputGestureText="Enter" Command="{Binding OpenCommand}" CommandParameter="{Binding SelectedItem}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Open20" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{l:Loc Common.ShowInExplorer}" Command="{Binding ShowInExplorerCommand}" CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="FolderOpen20" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{l:Loc Common.CopyPath}" Command="{Binding CopyPathCommand}" CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Copy20" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{l:Loc DiskPage.Move}" Command="{Binding MoveCommand}" CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="FolderArrowRight20" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{l:Loc DiskPage.Recycle}" InputGestureText="Del" Command="{Binding DeleteToRecycleBinCommand}" CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Delete20" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{l:Loc DiskPage.DeleteForever}" InputGestureText="Shift+Del" Command="{Binding DeletePermanentlyCommand}" CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="DeleteDismiss20" /></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{l:Loc DiskPage.Col.Name}" Width="*" MinWidth="160" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FsItemViewModel}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding FullPath}">
                                        <ui:SymbolIcon Symbol="{Binding Icon}" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{l:Loc DiskPage.Col.Share}" Width="132" SortMemberPath="Size">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FsItemViewModel}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="60" Height="6" CornerRadius="3" VerticalAlignment="Center"
                                                Background="{DynamicResource ControlStrokeColorDefaultBrush}">
                                            <Border HorizontalAlignment="Left" CornerRadius="3"
                                                    Width="{Binding BarWidth, Mode=OneTime}"
                                                    Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding PercentText}" FontSize="12" Margin="8,0,0,0"
                                                   Style="{StaticResource SecondaryText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{l:Loc DiskPage.Col.Size}" Width="90" SortMemberPath="Size"
                                            Binding="{Binding Size, Converter={StaticResource Bytes}}" />
                        <DataGridTextColumn Header="{l:Loc DiskPage.Col.OnDisk}" Width="100" SortMemberPath="Allocated"
                                            Binding="{Binding Allocated, Converter={StaticResource Bytes}}" />
                        <DataGridTextColumn Header="{l:Loc DiskPage.Col.Files}" Width="90" SortMemberPath="FileCount"
                                            Binding="{Binding FileCount, StringFormat='{}{0:N0}'}" />
                        <DataGridTextColumn Header="{l:Loc DiskPage.Col.Type}" Width="65" Binding="{Binding Kind}" />
                        <DataGridTextColumn Header="{l:Loc DiskPage.Col.Modified}" Width="135" SortMemberPath="LastWrite"
                                            Binding="{Binding LastWrite, StringFormat='{}{0:dd.MM.yy HH:mm}'}" />
                    </DataGrid.Columns>
                </ui:DataGrid>

                <TextBlock Grid.Row="2" Margin="2,8,0,0" FontSize="12" Style="{StaticResource SecondaryText}"
                           Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Grid>
    </Grid>
</Page>
